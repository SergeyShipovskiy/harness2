# Subscription roles (JobBench): <tool>:<model>, tool in opencode | codex | claude.
# See docs/SETUP.md#subscriptions-codex-and-claude-code-roles.
# HARNESS2_EXECUTOR=claude:claude-opus-5-5
# HARNESS2_IMPROVER=codex:gpt-6-astra
# HARNESS2_JUDGE=codex:gpt-6.1-sol
# HARNESS2_CODEX_VERSION=0.160.0
# HARNESS2_JUDGE_CODEX_VERSION=0.160.0

# Vertex AI (the upstream configuration).
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# HARNESS2_SOLVER_MODEL=google-vertex/<gemini-model>
# HARNESS2_IMPROVER_MODEL=google-vertex/<gemini-model>
# HARNESS2_JUDGE_MODEL=<gemini-model>

# HARNESS2_RUNS_DIR=runs
