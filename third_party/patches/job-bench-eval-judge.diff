+def openai_complete(
+    system: str,
+    user_content: str | list[dict],
+    judge_model: str,
+    api_base: str,
+    api_key: str,
+    timeout_sec: int,
+    extra_kwargs: dict,
+) -> str:
+    client = get_openai_client(api_base, api_key)
+    response = client.chat.completions.create(
+        model=judge_model,
+        messages=[
+            {"role": "system", "content": system},
+            {"role": "user", "content": user_content},
+        ],
+        # 64k so extended-thinking effort doesn't consume the whole budget and starve the
+        # verdict output (thinking + verdict share this cap; 32k was too small at effort=high,
+        # which silently zeroed rubrics on hard tasks).
+        max_completion_tokens=int(os.environ.get("JUDGE_MAX_COMPLETION_TOKENS", "65536")),
+        temperature=0.0,
+        timeout=timeout_sec,
+        **extra_kwargs,
+    )
+    message = response.choices[0].message if response.choices else None
+    content = getattr(message, "content", None) if message else None
+    if not content:
+        finish = response.choices[0].finish_reason if response.choices else "unknown"
+        raise ValueError(f"Judge returned empty content (finish_reason={finish})")
+    return content.strip()
+
