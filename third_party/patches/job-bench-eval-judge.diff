+def codex_complete(prompt: str, judge_model: str, image_paths: list[Path], timeout_sec: int) -> str:
+    """One `codex exec` turn on the judge's own CODEX_HOME; returns the schema-shaped reply.
+
+    Read-only sandbox, no user config, rules or web search, in an empty directory: the
+    judge sees the prompt and the images, nothing of the harness under evaluation.
+    """
+    effort = os.environ.get("JUDGE_REASONING_EFFORT", "low").strip() or "low"
+    with tempfile.TemporaryDirectory(prefix="codex-judge-") as work:
+        schema = Path(work) / "schema.json"
+        schema.write_text(json.dumps(BATCH_SCHEMA), encoding="utf-8")
+        last = Path(work) / "last.json"
+        cmd = [
+            os.environ.get("CODEX_JUDGE_BIN", "codex"), "exec",
+            "--model", judge_model,
+            "--sandbox", "read-only",
+            "--skip-git-repo-check",
+            "--ephemeral",
+            "--ignore-user-config",
+            "--ignore-rules",
+            "-c", 'web_search="disabled"',
+            "-c", f'model_reasoning_effort="{effort}"',
+            "--output-schema", str(schema),
+            "-o", str(last),
+            "-C", work,
+        ]
+        for path in image_paths:
+            cmd += ["-i", str(path)]
+        cmd += ["--", "-"]
+        proc = subprocess.run(
+            cmd,
+            input=prompt,
+            cwd=work,
+            capture_output=True,
+            text=True,
+            timeout=timeout_sec,
+        )
+        reply = last.read_text(encoding="utf-8").strip() if last.is_file() else ""
+    if proc.returncode != 0 or not reply:
+        raise RuntimeError(f"codex exec exited {proc.returncode} without a reply: {proc.stderr[-300:]}")
+    return reply
+
+
+def judge_rubrics_codex(
+    pending: list[tuple[int, dict]],
+    file_contents: str,
+    judge_model: str,
+    timeout_sec: int,
+    max_retries: int,
+    image_paths: list[Path] | None,
+) -> list[tuple[int, dict, dict]]:
+    """Judge every pending rubric in one call, so the deliverables are read once, not per rubric."""
+    criteria_by_idx = {idx: normalize_criteria(rubric) for idx, rubric in pending}
+    blocks = []
+    for idx, rubric in pending:
+        listed = "\n".join(f"  Criterion {c}: {text}" for c, text in enumerate(criteria_by_idx[idx]))
+        blocks.append(f"### Rubric {idx}\n{rubric.get('rubric', '')}\nCriteria:\n{listed}")
+    vision = [p for p in (image_paths or []) if any(rubric_needs_vision(r) for _, r in pending)]
+    vision = [p for p in vision if image_to_data_url(p) is not None]
+    prompt = f"""You are an evaluation judge. Evaluate EVERY rubric below, and within each rubric EVERY criterion, independently.
+
+## Rubrics
+{chr(10).join(blocks)}
+
+## Output Files Content
+The following are the contents of all output files to evaluate:
+
+{file_contents}
+
+## Evaluation Rules
+- Evaluate EACH criterion independently: PASS or FAIL only
+- Semantic matching is acceptable (you don't need exact wording match)
+- A rubric passes ONLY if ALL its criteria pass
+- Include specific evidence from the output files{' and the attached images' if vision else ''}
+
+## Output Format
+Return one entry per rubric, using the rubric number above as "index", and within it one
+"criteria_results" entry per criterion, using the criterion number as "index".
+"""
+
+    last_error: Exception | None = None
+    raw_response = ""
+    for attempt in range(max_retries):
+        try:
+            raw_response = codex_complete(prompt, judge_model, vision, timeout_sec)
+            parsed = {int(r["index"]): r for r in json.loads(raw_response).get("rubrics", [])}
+            missing = [idx for idx, _ in pending if idx not in parsed]
+            if missing:
+                raise ValueError(f"judge reply has no entry for rubrics {missing}")
+            break
+        except Exception as exc:
+            last_error = exc
+            parsed = None
+            if attempt < max_retries - 1:
+                time.sleep(2)
+
+    out = []
+    for idx, rubric in pending:
+        criteria = criteria_by_idx[idx]
+        weight = rubric.get("weight", 0)
+        debug = {
+            "api_base": CODEX_API_BASE,
+            "parse_status": "schema" if parsed else "failed",
+            "api_exit_code": 0 if parsed else 2,
+            "criterion_count": len(criteria),
+            "criteria_list_text": "\n".join(f"Criterion {c}: {t}" for c, t in enumerate(criteria)),
+            "rubric_text": rubric.get("rubric", ""),
+            "raw_response": raw_response,
+            "error": "" if parsed else str(last_error),
+            "vision_used": bool(vision),
+            "attached_images": [p.name for p in vision],
+        }
+        if not parsed:
+            failed = build_failed_rubric_result(idx, rubric, f"Failed after {max_retries} retries: {last_error}")
+            out.append((idx, failed, debug))
+            continue
+        entry = parsed[idx]
+        by_criterion = {int(c["index"]): c for c in entry.get("criteria_results", [])}
+        enriched = [
+            {
+                "index": c,
+                "criterion": text,
+                "passed": bool(by_criterion.get(c, {}).get("passed", False)),
+                "reasoning": by_criterion.get(c, {}).get("reasoning", ""),
+                "evidence": by_criterion.get(c, {}).get("evidence", ""),
+            }
+            for c, text in enumerate(criteria)
+        ]
+        rubric_passed = bool(entry.get("rubric_passed", False))
+        out.append(
+            (
+                idx,
+                {
+                    "index": idx,
+                    "rubric": rubric.get("rubric", ""),
+                    "weight": weight,
+                    "result": {
+                        "passed": rubric_passed,
+                        "score": weight if rubric_passed else 0,
+                        "criteria_count": len(criteria),
+                        "criteria_passed": sum(1 for item in enriched if item["passed"]),
+                        "criteria_results": enriched,
+                        "overall_reasoning": entry.get("overall_reasoning", ""),
+                    },
+                },
+                debug,
+            )
+        )
+    return out
+
