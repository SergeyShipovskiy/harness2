+AGY_API_BASE = "agy"
+# agy caps a turn's input near 142k tokens and drops the rest of the prompt silently.
+AGY_INPUT_TOKEN_CAP = int(os.environ.get("AGY_INPUT_TOKEN_CAP", "140000"))
+
+
+class AgyPromptTooLong(RuntimeError):
+    """The prompt hit agy's input cap; retrying would truncate it the same way."""
+
+
+def agy_complete(system: str, prompt: str, judge_model: str, image_paths: list[Path], timeout_sec: int) -> str:
+    """One headless Antigravity CLI turn in a scratch directory; returns the reply text.
+
+    The prompt goes through stdin because it can exceed what argv carries. Images are
+    copied next to it and the agent opens them with its own file viewer.
+    """
+    with tempfile.TemporaryDirectory(prefix="agy-judge-") as work:
+        text = f"{system}\n\n{prompt}"
+        if image_paths:
+            lines = []
+            for i, path in enumerate(image_paths, start=1):
+                local = f"image{i}{path.suffix.lower()}"
+                shutil.copy(path, Path(work) / local)
+                lines.append(f"- {local} (deliverable file {path.name})")
+            text += (
+                "\n## Attached Images\nThese files are in the current directory. "
+                "Open each one with view_file before judging:\n" + "\n".join(lines) + "\n"
+            )
+        cmd = [
+            os.environ.get("AGY_BIN", "agy"),
+            "--input-format", "stream-json",
+            "--output-format", "stream-json",
+            "--disable-slash-commands",
+            "--print-timeout", f"{timeout_sec}s",
+        ]
+        if judge_model:
+            cmd += ["--model", judge_model]
+        proc = subprocess.run(
+            cmd,
+            input=json.dumps({"event": "user", "message": {"content": text}}) + "\n",
+            cwd=work,
+            capture_output=True,
+            text=True,
+            timeout=timeout_sec + 60,
+        )
+    result = None
+    for line in proc.stdout.splitlines():
+        try:
+            event = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+        if isinstance(event, dict) and event.get("event") == "result":
+            result = event.get("result") or {}
+    if result is None:
+        raise RuntimeError(f"agy exited {proc.returncode} without a result: {proc.stderr[-300:]}")
+    if result.get("status") != "SUCCESS":
+        raise RuntimeError(f"agy status {result.get('status')}: {result.get('error', '')}")
+    used = int((result.get("usage") or {}).get("input_tokens") or 0)
+    if used >= AGY_INPUT_TOKEN_CAP:
+        raise AgyPromptTooLong(f"agy input reached {used} tokens; the prompt was truncated")
+    return result.get("response") or ""
+
